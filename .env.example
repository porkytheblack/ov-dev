# ============================================================================
# Overwatch — example environment. Copy to `.env` and edit.
# ============================================================================

# --- Core services ---
POSTGRES_PASSWORD=overwatch
DATABASE_URL=postgres://overwatch:overwatch@postgres:5432/overwatch

REDIS_URL=redis://redis:6379

MINIO_USER=overwatch
MINIO_PASSWORD=overwatch-secret
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=overwatch
MINIO_SECRET_KEY=overwatch-secret
MINIO_BUCKET_SEGMENTS=overwatch-segments
MINIO_BUCKET_FRAMES=overwatch-frames
MINIO_BUCKET_CLIPS=overwatch-clips

LOG_LEVEL=info

# --- Detector ---
MODEL_PATH=/models/yolo11l.pt
DEVICE=cpu                       # cpu | cuda:0 | mps
BATCH_SIZE=4
TRACKER_CONFIG=botsort.yaml
# Disqualified classes — dropped at the detector so no wrong bbox is drawn
# (overlay), persisted, or sent to the engine. Default covers the named
# implausible ones + wild/aviation classes the model only hallucinates in a
# yard. Plausible classes (truck, bus, dog, cat, bird=chicken, horse) are
# kept. Comma-separated, lowercase.
DETECT_DENY_CLASSES=boat,sheep,cow,airplane,train,elephant,bear,zebra,giraffe

# Class-aware confidence floor (incident-engine) — filters detector noise.
# People are easy to ID (lower bar); other objects need a higher bar.
OV_CONFIDENCE_PERSON=0.65
OV_CONFIDENCE_DEFAULT=0.8

# --- Fire & smoke detection ---
# A SECOND, dedicated Ultralytics model (separate from the COCO detector)
# run on a throttled cadence so CPU cost is bounded (no VLM). Weights are
# auto-downloaded once into the persistent /models volume on first start.
FIRE_DETECTION=1                 # 0/false to disable entirely
FIRE_MODEL_PATH=/models/fire.pt
FIRE_MODEL_URL=https://huggingface.co/SalahALHaismawi/yolov26-fire-detection/resolve/main/best.pt
FIRE_INTERVAL_SECONDS=5          # max 1 fire inference / camera / N sec
FIRE_CONFIDENCE_THRESHOLD=0.50   # detector-side model conf
FIRE_CLASSES=fire,smoke          # keep these classes ("other" is noisy)
OV_CONFIDENCE_FIRE=0.6           # engine floor: below this, fire is ignored
# At/above this confidence the engine alerts directly. BETWEEN OV_CONFIDENCE_FIRE
# and this, the frame is sent to the Mimo vision model to confirm real fire vs
# a false alarm (e.g. a red bicycle) before alerting — fail-open if it can't
# decide. Set to 1 to disable adjudication (always alert directly).
OV_FIRE_HIGH_CONF=0.9
# Temporal persistence — a single false-positive frame must NEVER act (alert
# OR adjudicate). Require ≥ MIN_HITS fire detections within WINDOW seconds
# first (real fire persists; tree/sky/lighting flicker doesn't).
OV_FIRE_MIN_HITS=3
OV_FIRE_WINDOW_SEC=40
# Min seconds between fire alerts per camera. Persisted in Postgres
# (fire_alert_log) so it holds across service restarts. Default 1 hour.
OV_FIRE_ALERT_COOLDOWN_SEC=3600

# --- Storage retention (operator wants ONLY clips kept) ---
# storage-prune signal drops segments past these windows on every tick (30m).
# Defaults in the signal (48h/168h) caused ~800GB/week accumulation.
SEGMENT_RETENTION_HOURS=1
SEGMENT_HARD_MAX_HOURS=2
# Frames bucket cleanup: detector should delete each frame after processing
# but orphans accumulate (consumer lag, restarts, fire-retention paths).
# Drop anything in overwatch-frames older than this on every prune tick.
FRAMES_RETENTION_MIN=10

# --- Camera-health watchdog (auto-recovery) ---
# Station signal runs every 2m; if too many enabled cameras have no fresh
# frame within CAMERA_STALE_SECS, it POSTs /admin/restart on ov-ingestor
# (which exits → docker restart policy brings it back with fresh workers)
# and Telegrams the operator. Catches the partial-RTSP-wedge pattern.
CAMERA_STALE_SECS=120
CAMERA_HEALTH_THRESHOLD=0.5
CAMERA_HEALTH_COOLDOWN_SEC=600

# --- Clip builder ---
# MUST match ov-api FOOTAGE_PRE_S / FOOTAGE_POST_S (in src/routes/incidents.ts).
# Markers are indexed from opened_at - PRE; mismatched padding shifts every
# scrubber tick by that many seconds relative to the actual frames.
PADDING_SECONDS_BEFORE=8
PADDING_SECONDS_AFTER=22

# --- Vision backend selector ---
# mimo  = ov-station drives the Mimo (Xiaomi) vision pipeline (default)
# local = legacy ov-vlm path against a local LM Studio / VLM endpoint below
VISION_BACKEND=mimo

# --- Legacy local VLM (only used when VISION_BACKEND=local) ---
VLM_ENDPOINT=http://host.docker.internal:1234/v1
VLM_MODEL=gemma3-it-vision
SAMPLE_FRAMES_PER_CLIP=8

# --- Notifier ---
CLIP_WAIT_TIMEOUT_SECONDS=120
DASHBOARD_BASE_URL=http://localhost:9090
DEEP_LINK_TOKEN_SECRET=change-me-to-32-byte-random
DEEP_LINK_TTL_HOURS=24

# --- WhatsApp (Cloud API) ---
# Meta webhook setup (App → WhatsApp → Configuration):
#   Callback URL : https://<your public domain>/webhook/whatsapp
#                  (Caddy proxies /webhook/whatsapp* → ov-whatsapp:3010;
#                   same public HTTPS domain as the dashboard. Local dev:
#                   http://localhost:9090/webhook/whatsapp)
#   Verify token : the value of WHATSAPP_WEBHOOK_VERIFY_TOKEN below
#   Subscribe to : the "messages" webhook field
# Authorize a number: dashboard → Settings → add subscriber, channel
#   "whatsapp", handle = the sender's number in wa_id form (digits, no +).
# Note: free-form replies only deliver inside WhatsApp's 24h window;
#   proactive alerts/recaps outside it require approved message templates.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=overwatch-verify

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Only set if api.telegram.org is unreachable from the host (restricted
# egress): a local Bot API server or reachable reverse proxy.
# TELEGRAM_API_BASE=https://api.telegram.org

# --- Localization ---
# IANA timezone the operator/compound is in. The agent reasons and reports
# all times in this zone (e.g. Africa/Nairobi, America/New_York). Default UTC.
OV_TIMEZONE=UTC

# =========================================================================
# Model providers
# =========================================================================
# Two independent switches:
#   VISION_PROVIDER  — drives ALL vision calls (analyze-clip, fire-verdict,
#                      window summaries).
#                      Options: mimo | gemini | openrouter.
#   AGENT_PROVIDER   — drives the conversational agent on the messengers.
#                      Options: mimo | kimi | minimax | gemini | openrouter.
# Either default falls back to "mimo" if unset, so existing deployments keep
# working. Set the provider, then drop the corresponding *_API_KEY below.
#
# OpenRouter recommendation: one OPENROUTER_API_KEY drives both switches,
# and you pick the upstream model per use case via OPENROUTER_VISION_MODEL
# (e.g. google/gemini-3.1-flash-lite) and OPENROUTER_CHAT_MODEL (e.g.
# moonshotai/kimi-k2 or minimax/minimax-m1).
VISION_PROVIDER=mimo
AGENT_PROVIDER=mimo

# --- Mimo (Xiaomi MiMo — https://mimo.xiaomi.com/) ---
# glove-core ships a dedicated MiMo adapter (handles reasoning_content + the
# adaptive thinking budget) — used when VISION_PROVIDER=mimo and/or
# AGENT_PROVIDER=mimo.
# Only the API key is required — MIMO_BASE_URL defaults to the Xiaomi MiMo
# gateway (https://api.xiaomimimo.com/v1). Override for CN / self-hosted.
MIMO_API_KEY=
MIMO_BASE_URL=
MIMO_CHAT_MODEL=mimo-v2.5
MIMO_VISION_MODEL=mimo-v2.5
# Optional per-use-case overrides (leave blank to reuse the shared values):
MIMO_VISION_BASE_URL=
MIMO_VISION_API_KEY=
# Chat reasoning (MiMo only). Effort: low|medium|high (unset = model decides;
# on the pro tier low/medium can suppress thinking — prefer high or unset):
MIMO_REASONING_EFFORT=
MIMO_INCLUDE_REASONING=false
# Optional tuning:
# MIMO_CHAT_MAX_TOKENS=1024
# MIMO_VISION_MAX_TOKENS=512
# MIMO_TIMEOUT_MS=120000
# Fire verdict gets a tight timeout (a fire can't wait 2 min); past it the
# adjudicator returns "unavailable" → suppress (operator policy):
# MIMO_FIRE_VERDICT_TIMEOUT_MS=25000

# --- Google Gemini (https://aistudio.google.com/) ---
# Used when VISION_PROVIDER=gemini and/or AGENT_PROVIDER=gemini.
# Vision: hand-rolled native client (Gemini's OpenAI-compat layer doesn't
# accept video parts). Chat: glove-core's gemini adapter (OpenAI-compat).
# Default model is gemini-2.5-flash-lite — full video understanding at the
# fastest tier. Get a key from AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Optional split (vision and chat can use different models):
# GEMINI_VISION_MODEL=gemini-2.5-flash-lite
# GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
# Optional base URL override (regional gateway / proxy):
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_VISION_BASE_URL=
# GEMINI_VISION_API_KEY=
# GEMINI_VISION_MAX_TOKENS=2048
# GEMINI_CHAT_MAX_TOKENS=2048
# GEMINI_TIMEOUT_MS=120000
# Tight timeout on fire verdict — past it returns "unavailable" → suppress:
# GEMINI_FIRE_VERDICT_TIMEOUT_MS=25000

# --- OpenRouter (https://openrouter.ai/) — vision + agent, one key ---
# A unified gateway across vendors. Recommended path if you want to A/B
# providers without juggling multiple keys / billing accounts.
#   VISION_PROVIDER=openrouter
#   AGENT_PROVIDER=openrouter
# Default vision model: google/gemini-3.1-flash-lite ($0.25/$1.50 per M
# tokens, 1M context, native video_url). Override per use case below.
# Other cheap video-capable slugs at the time of writing:
#   bytedance-seed/seed-2.0-mini    — $0.10/$0.40 per M, 262K ctx
#   google/gemma-4-26b-a4b-it:free  — free open Gemma (4 / 26B A4B)
#   inclusionai/ling-2.6-flash      — $0.01/$0.03 per M (lesser-known)
# Chat slug suggestions for the agent A/B:
#   moonshotai/kimi-k2     # Kimi
#   minimax/minimax-m1     # MiniMax (NOT Xiaomi MiMo — distinct vendor)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
# Optional per-use-case overrides:
OPENROUTER_VISION_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_CHAT_MODEL=
# Optional analytics / moderation headers (shown in OpenRouter's app
# leaderboard and billing reports — leave blank to be anonymous):
# OPENROUTER_HTTP_REFERER=
# OPENROUTER_APP_TITLE=Overwatch
# Optional tuning:
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_VISION_MAX_TOKENS=2048
# OPENROUTER_CHAT_MAX_TOKENS=2048
# OPENROUTER_TIMEOUT_MS=120000
# OPENROUTER_FIRE_VERDICT_TIMEOUT_MS=25000

# --- Moonshot Kimi (https://platform.moonshot.ai/) — agent only ---
# Used when AGENT_PROVIDER=kimi. OpenAI-compatible via glove-core's adapter.
MOONSHOT_API_KEY=
KIMI_MODEL=kimi-k2.5
# KIMI_MAX_TOKENS=2048

# --- MiniMax (https://www.minimax.io/) — agent only ---
# Used when AGENT_PROVIDER=minimax. OpenAI-compatible via glove-core's adapter.
# NOT the same as Xiaomi MiMo — these are separate vendors with similar names.
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.5
# MINIMAX_MAX_TOKENS=2048

# Agent request timeout shared across providers (Kimi/MiniMax/Gemini):
# AGENT_TIMEOUT_MS=120000

# --- Cloudflare R2 (transient store for clips during vision analysis) ---
# A clip is uploaded here so the vision model can fetch it over a public
# URL, then deleted once the summary is written.
R2_ACCOUNT_ID=
# …or set the full S3 endpoint instead of the account id:
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=overwatch-vision
# Public base URL for the bucket (r2.dev domain or a custom domain):
R2_PUBLIC_BASE_URL=
# Minutes a clip may live in R2 before the sweep reclaims it:
R2_TTL_MINUTES=30

# --- Storage pruner (recurring `storage-prune` Station signal) ---
# The DVR is the real archive; here we only keep the alert artifacts
# (incident clips + built footage + posters). Raw segments and orphans are
# reclaimed automatically. All conservative; the DB never deletes a clip
# before its own retention_until.
SEGMENT_RETENTION_HOURS=48        # keep all segments newer than this
SEGMENT_HARD_MAX_HOURS=168        # drop segments older than this regardless
SEGMENT_KEEP_MARGIN_SEC=300       # slack kept around each incident window
PRUNE_BATCH=2000                  # max objects reclaimed per run

# --- Station (background jobs / orchestration) ---
# Persists into the same Postgres (DATABASE_URL) via station-adapter-postgres.
STATION_HEALTH_PORT=8005
# station-kit HTTP API (ov-station-api container): trigger + run status + keys.
STATION_API_PORT=4400
STATION_ENDPOINT=http://ov-station-api:4400
# Admin creds for the Station dashboard + minting API keys.
STATION_DASHBOARD_USER=admin
STATION_DASHBOARD_PASSWORD=overwatch
# Provision with `make station-key`, then paste the sk_live_... value here
# and restart ov-api. ov-api uses this to trigger the vision broadcast.
STATION_API_KEY=

# --- API + Dashboard ---
API_PORT=3001
SESSION_SECRET=change-me-to-32-byte-random
# Dashboard SSR (server-side) talks to ov-api directly on the docker network.
# Browser-side fetches use relative URLs (Caddy proxies /api/* → ov-api).
INTERNAL_API_URL=http://ov-api:3001
