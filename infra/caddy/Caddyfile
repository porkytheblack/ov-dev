{
  admin off
}

# Local development - HTTP on port 80.
# For production: set OVERWATCH_DOMAIN and uncomment the tls block.

:80 {
  encode gzip

  # API + WebSocket
  handle /api/* {
    reverse_proxy ov-api:3001
  }
  handle /openapi.json {
    reverse_proxy ov-api:3001
  }
  handle /events {
    reverse_proxy ov-api:3001
  }

  # Live video / stream gateway. The gateway is on :8989 and proxies LL-HLS
  # + WHEP from mediamtx (which listens internally on 8888/8889). The buffer
  # must be off so LL-HLS partial segments stream out as they're produced.
  handle /stream/* {
    reverse_proxy ov-stream-gateway:8989 {
      flush_interval -1
    }
  }

  # WhatsApp webhook. Tolerate the common /webhooks (plural) typo and any
  # sub-path by normalising to the canonical path before proxying — Meta
  # follows no redirects on webhook verify/delivery, so we rewrite, not redir.
  @whatsapp path /webhook/whatsapp* /webhooks/whatsapp*
  handle @whatsapp {
    rewrite * /webhook/whatsapp
    reverse_proxy ov-whatsapp:3010
  }

  # MinIO console (optional). Bare /minio-console (no trailing slash) would
  # otherwise fall through to the dashboard 404 — redirect it to the slash.
  handle /minio-console {
    redir * /minio-console/ 308
  }
  handle /minio-console/* {
    reverse_proxy minio:9001
  }

  # Dashboard
  handle {
    reverse_proxy ov-dashboard:3000
  }
}
